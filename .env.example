# Database Configuration (PostgreSQL on Supabase)
# Use transaction pooler URL (port 6543) or direct connection (port 5432)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres

# JWT Authentication & Security
# Generate a secure 32-byte secret using: openssl rand -hex 32
JWT_SECRET_KEY=your_super_secret_hex_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Google Gemini API Key (Free tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# GitHub Personal Access Token (Optional: raises rate limit from 60 to 5,000 req/hr)
GITHUB_TOKEN=
